{
  "name": "mise",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "infra"
  ],
  "scripts": {
    "dev": "bun run --filter @mise/web build && bun run --filter @mise/worker dev",
    "seed": "bun run --filter @mise/worker seed",
    "screenshot": "bun run --filter @mise/worker screenshot",
    "eval": "bun run --filter @mise/worker eval",
    "eval:agent": "bun run --filter @mise/worker eval:agent",
    "test": "bun test packages ./scripts",
    "test:worker": "bun run --filter @mise/worker test",
    "test:web": "bun run --filter @mise/web test",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit -p scripts",
    "lint": "biome check .",
    "check:private": "bun scripts/check-private.ts",
    "ci": "bun run lint && bun run typecheck && bun run check:private && bun run check:web-calls && bun run check:tests-run && bun test packages ./scripts && bun run --filter @mise/web build && bun run test:worker && bun run test:web",
    "check:web-calls": "bun scripts/check-web-calls.ts",
    "check:tests-run": "bun scripts/check-tests-run.ts",
    "check:export": "bun scripts/check-export.ts",
    "check:stories": "bun scripts/check-story-coverage.ts",
    "wizard": "bash scripts/setup-deployment.sh",
    "trust:pulumi-ci": "bun scripts/trust-pulumi-ci.ts",
    "ci:summary": "bun scripts/ci-summary.ts",
    "deployed": "bun scripts/deployed.ts",
    "transcript": "bun scripts/transcript.ts",
    "sentry": "bun scripts/sentry.ts",
    "upstream-notes": "bun scripts/upstream-notes.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  },
  "trustedDependencies": [],
  "packageManager": "bun@1.4.4",
  "overrides": {
    "seroval": "1.7.9",
    "seroval-plugins": "1.7.8",
    "miniflare": {
      "undici": "7.30.2"
    }
  }
}
