{
  "name": "mise",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "infra"
  ],
  "scripts": {
    "dev": "bun run --filter @mise/web build && bun run --filter @mise/worker dev",
    "seed": "bun run --filter @mise/worker seed",
    "screenshot": "bun run --filter @mise/worker screenshot",
    "eval": "bun run --filter @mise/worker eval",
    "test": "bun test packages",
    "test:worker": "bun run --filter @mise/worker test",
    "test:web": "bun run --filter @mise/web test",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit -p scripts",
    "lint": "biome check .",
    "check:private": "bun scripts/check-private.ts",
    "ci": "bun run lint && bun run typecheck && bun run check:private && bun test packages && bun run --filter @mise/web build && bun run test:worker && bun run test:web",
    "check:export": "bun scripts/check-export.ts",
    "check:stories": "bun scripts/check-story-coverage.ts",
    "wizard": "bash scripts/setup-deployment.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  },
  "trustedDependencies": [],
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "@sentry/cloudflare@11.4.0": "patches/@sentry%2Fcloudflare@11.4.0.patch"
  }
}
