// Hostnames, zones and secrets live outside the repo (ADR 0005); Pulumi binds the custom domain.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mise",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Only the Access-protected custom domain serves Mise: no workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/cal/*", "/kitchen-display/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "Household", "class_name": "Household" }]
  },
  // Recipe photos under photos/, nightly exports under exports/. Pulumi creates the bucket.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "mise" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Household"] }]
}
