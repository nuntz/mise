// Hostnames, zones and secrets live outside the repo (ADR 0005); Pulumi binds the custom domain.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mise",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "Household", "class_name": "Household" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Household"] }]
}
